FROM python:3.12-slim
WORKDIR /research
COPY . /research
RUN python -c 'import tomllib; from pathlib import Path; p=[Path("pyproject.toml"),Path("integrations/ata_research/pyproject.toml")]; Path("/tmp/research-requirements.txt").write_text("\n".join(d for f in p for d in tomllib.loads(f.read_text())["project"]["dependencies"]))' && pip install --no-cache-dir -r /tmp/research-requirements.txt && pip check
WORKDIR /research/integrations/ata_research/src
ENV PYTHONPATH=/research ASTOCK_RESEARCH_API_HOST=0.0.0.0
CMD ["python", "-m", "research_api.app"]
